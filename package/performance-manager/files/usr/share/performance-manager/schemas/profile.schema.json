{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwrt-performance-manager.local/schema/profile.json",
  "title": "BuildProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "extends",
    "targets",
    "requiredPackages",
    "recommendedPackages",
    "conditionalPackages",
    "expectedCommands",
    "expectedCapabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredPackages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "recommendedPackages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conditionalPackages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "whenCapability"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "whenCapability": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "expectedCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.+-]+$"
      },
      "uniqueItems": true
    },
    "expectedCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
