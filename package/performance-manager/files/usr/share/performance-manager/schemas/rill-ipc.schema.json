{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwrt-performance-manager.local/schema/rill-ipc.json",
  "title": "Generic Rill Runtime v3 request",
  "description": "Runtime v3 subprocess envelope. Product payloads remain opaque to the generic Runtime; Core owns legality and execution policy.",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/handshakeEnvelope"},
    {"$ref": "#/$defs/healthEnvelope"},
    {"$ref": "#/$defs/decideEnvelope"},
    {"$ref": "#/$defs/feedbackEnvelope"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["requestId", "apiVersion", "clientIdentity", "partitionKey", "featureSchemaHash", "modelGeneration", "stateGeneration", "payloadLimit", "request"],
      "properties": {
        "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
        "apiVersion": {"const": 3},
        "clientIdentity": {"type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
        "partitionKey": {"type": "string", "minLength": 1, "maxLength": 128},
        "capability": {"type": "string", "minLength": 1},
        "deadlineUnixMs": {"type": "integer", "minimum": 0},
        "featureSchemaHash": {"type": "string", "minLength": 1},
        "modelGeneration": {"type": "integer", "minimum": 1},
        "stateGeneration": {"type": "integer", "minimum": 0},
        "payloadLimit": {"type": "integer", "minimum": 1},
        "request": {"type": "object"}
      },
      "additionalProperties": false
    },
    "handshakeEnvelope": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "properties": {"request": {"type": "object", "additionalProperties": false, "required": ["method"], "properties": {"method": {"const": "handshake"}}}}}]},
    "healthEnvelope": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "properties": {"request": {"type": "object", "additionalProperties": false, "required": ["method"], "properties": {"method": {"const": "health"}}}}}]},
    "decideEnvelope": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["capability"], "properties": {"request": {"type": "object", "additionalProperties": false, "required": ["method", "context"], "properties": {"method": {"const": "decide"}, "context": {"type": "object"}, "deterministicSeed": {"type": "integer", "minimum": 0}}}}}]},
    "feedbackEnvelope": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["capability"], "properties": {"request": {"type": "object", "additionalProperties": false, "required": ["method", "decisionId", "selectedActionId", "reward", "outcomeTimeMs", "generation"], "properties": {"method": {"const": "feedback"}, "decisionId": {"type": "string", "minLength": 1, "maxLength": 128}, "selectedActionId": {"type": "string", "minLength": 1, "maxLength": 96}, "reward": {"type": "number"}, "outcomeTimeMs": {"type": "integer", "minimum": 0}, "generation": {"type": "integer", "minimum": 0}}}}}]}
  }
}
