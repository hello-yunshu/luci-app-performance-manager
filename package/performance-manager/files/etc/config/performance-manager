config core 'main'
	option enabled '1'
	option automation 'conservative'
	option conservative_auto '1'
	option assisted_auto '0'
	option maintenance_start '03:00'
	option maintenance_end '05:00'
	option assisted_max_bytes_per_second '1048576'
	option goal 'balanced'
	option profile 'recommended'
	option telemetry '1'
	option history '1'
	option failsafe '1'
	option telemetry_interval '45'
	option deep_interval '600'
	option smart_rill_auto '1'
	option min_validated_samples '8'
	option min_confidence_conservative '0.65'
	option min_confidence_assisted '0.75'
	option performance_drift_threshold '0.20'
	option drift_recovery_samples '3'
	option action_cooldown_base_seconds '600'
	option commit_confirm_seconds '30'
	option state_dir '/tmp/performance-manager'
	option persistent_dir '/etc/performance-manager'
	option health_dns_name 'openwrt.org'
	option oom_window_seconds '600'
	option max_load_per_cpu '2'
	option max_cpu_steal_percent '20'
	option max_thermal_millicelsius '90000'

config rill 'shadow'
	option enabled '1'
	option binary ''
	option mode 'shadow'
	# Empty uses the package-owned generic Runtime at /usr/bin/rill-runtime;
	# an explicit absolute executable is an opt-in override and never falls back.
	option max_message '65536'
	option timeout_ms '1000'
	option state_file '/etc/performance-manager/rill/runtime-state.json'

config benchmark 'benchmark'
	option require_explicit_start '1'
	option one_variable '1'
	option allow_background_saturation '0'
	option default_measurement_class 'passive_before_after'
	option candidate_timeout_seconds '120'
	option session_idle_seconds '600'
