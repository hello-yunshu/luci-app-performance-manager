# Portable real-Core ucode runtime harness image (hosted Actions and local Docker).
# The workflow prepares .portable-rootfs from the pinned official OpenWrt
# x86_64 rootfs and installs the exact OpenWrt ucode modules before this image
# is built. Alpine does not ship OpenWrt's ucode-mod-* packages.
FROM scratch
ADD .portable-rootfs/ /
ENV PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/lib:/usr/lib
WORKDIR /work
ENTRYPOINT ["/bin/sh"]
