{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwrt-performance-manager.local/schema/rill-ipc-response.json",
  "title": "Generic Rill Runtime v3 response",
  "description": "Generic Runtime v3 response envelope. Core validates the response and retains all execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "apiVersion", "runtimeIdentity", "modelGeneration", "stateGeneration", "response"],
  "properties": {
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "apiVersion": {"const": 3},
    "runtimeIdentity": {"type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "modelGeneration": {"type": "integer", "minimum": 0},
    "stateGeneration": {"type": "integer", "minimum": 0},
    "response": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "capabilities", "featureSchemaHash", "handlerApiVersion"], "properties": {"kind": {"const": "handshake"}, "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}}, "featureSchemaHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "handlerApiVersion": {"type": "integer", "minimum": 1}, "channel": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "healthy"], "properties": {"kind": {"const": "health"}, "healthy": {"type": "boolean"}, "status": {"type": "string"}, "reasonCodes": {"type": "array", "items": {"type": "string"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "output"], "properties": {"kind": {"const": "result"}, "output": {"type": "object"}, "decisionId": {"type": "string", "minLength": 1, "maxLength": 128}, "decisionGeneration": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "error"], "properties": {"kind": {"const": "error"}, "error": {"type": "object", "required": ["code", "message", "retryable"], "additionalProperties": false, "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}}}}
      ]
    }
  }
}
