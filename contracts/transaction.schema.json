{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwrt-performance-manager.local/schema/transaction.json",
  "title": "Transaction",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "transactionId",
    "actionId",
    "candidateId",
    "executionSource",
    "rillDecision",
    "state",
    "requiredLocks",
    "bootId",
    "before",
    "verification",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 2
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "actionId": {
      "type": "string",
      "minLength": 1
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "businessActionId": {
      "type": "string",
      "minLength": 1
    },
    "executionSource": {
      "enum": [
        "manual",
        "conservative",
        "rill-advisory",
        "benchmark-rill",
        "assisted-rill"
      ]
    },
    "rillDecision": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "decisionId",
        "actionId",
        "contextKey",
        "goal",
        "modelGeneration",
        "bootId",
        "executionAuthority",
        "ownerType",
        "ownerId"
      ],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "actionId": { "type": "string", "minLength": 1 },
        "contextKey": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "modelGeneration": { "const": 2 },
        "bootId": { "type": "string", "minLength": 1 },
        "executionAuthority": {"const": "safe-direct"},
        "ownerType": {"const": "transaction"},
        "ownerId": {"type": "string", "minLength": 1}
      }
    },
    "state": {
      "enum": [
        "planned",
        "locked",
        "snapshotted",
        "pending",
        "applied",
        "verified",
        "awaiting_confirm",
        "committed",
        "rolled_back",
        "failed"
      ]
    },
    "requiredLocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bootId": {
      "type": "string",
      "minLength": 1
    },
    "deadlineMonotonicMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "before": {
      "type": [
        "object",
        "null"
      ]
    },
    "applied": {
      "type": [
        "object",
        "null"
      ]
    },
    "verification": {
      "type": "object"
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "commitPolicy": {
      "type": [
        "string",
        "null"
      ]
    },
    "requiresCommitConfirm": {
      "type": "boolean"
    },
    "pendingMarker": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedMonotonicMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
