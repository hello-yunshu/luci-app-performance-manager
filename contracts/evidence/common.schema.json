{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hello-yunshu.github.io/luci-app-performance-manager/evidence/common.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "pmCommitSha", "buildRunId", "verdict", "passed", "controller", "buildArtifacts", "installedArtifacts", "subchecks", "rawFacts", "primaryPackage", "primaryPackageSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "gate": {"type": "string"},
    "pmCommitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "buildRunId": {"type": ["string", "integer"]},
    "primaryPackage": {"type": "string"},
    "primaryPackageSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "passed": {"type": "boolean"},
    "adapterSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "durationSeconds": {"type": "integer", "minimum": 0},
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "path", "sha256"],
      "properties": {"source": {"const": "repository"}, "path": {"type": "string", "pattern": "^tools/stable-testbed/"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "buildArtifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["performance-manager", "luci-app-performance-manager", "performance-manager-rill", "luci-app-performance-manager-all"],
      "properties": {
        "performance-manager": {"type": "object", "additionalProperties": true},
        "luci-app-performance-manager": {"type": "object", "additionalProperties": true},
        "performance-manager-rill": {"type": "object", "additionalProperties": true},
        "luci-app-performance-manager-all": {"type": "object", "additionalProperties": true}
      }
    },
    "installedArtifacts": {
      "type": "object", "additionalProperties": true,
      "required": ["performance-manager", "luci-app-performance-manager", "performance-manager-rill", "luci-app-performance-manager-all"]
    },
    "subchecks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "rawFacts": {"type": "object", "additionalProperties": true},
    "validationErrors": {"type": "array", "items": {"type": "string"}}
  }
}
