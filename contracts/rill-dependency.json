{
  "schemaVersion": 4,
  "contract": "pm-rill-dependency",
  "description": "Performance Manager owns its pm-rill-shadow adapter and consumes the generic crates.io rill-ml package. No RillML Release adapter artifact, stable-index selection, or upstream PM adapter owner is part of the active contract.",
  "protocol": {
    "owner": "OpenWrt Performance Manager",
    "name": "pm-rill-shadow",
    "version": 1,
    "schemaFile": "contracts/rill-ipc.schema.json",
    "requiredOps": ["status", "observe", "outcome"],
    "contextKeyPattern": "^ctx-v1:",
    "contextKeyMaxLength": 512
  },
  "capabilities": {
    "required": ["context-partitioned-model", "goal-partition", "validated-outcome", "decision-ledger", "model-health"],
    "optional": ["bandit", "exploration", "recommendation"]
  },
  "adapter": {
    "owner": "hello-yunshu/luci-app-performance-manager",
    "binary": "performance-manager-rill-adapter",
    "version": "1.0.2",
    "canonicalPath": "/usr/sbin/performance-manager-rill-adapter",
    "license": "MIT"
  },
  "rillMl": {
    "package": "rill-ml",
    "registry": "crates.io",
    "version": "1.5.3",
    "resolution": "exact",
    "features": ["serde"]
  },
  "rillRelease": {
    "tag": "v1.5.3",
    "commit": "621ed42bf6a4ea29b19f45a5dfa75f50f68173a9",
    "stableIndexSha256": "05b73e70ab4a58e2bf3f7e4b4ae1487b9e3a56cb9e2cea80a2730ca84ac52dde"
  },
  "state": {
    "directory": "/etc/performance-manager/rill",
    "file": "adapter-state.json",
    "schemaVersion": 1,
    "legacyVersions": ["PM v1.0.0 + Rill 1.2.0 adapter", "PM v1.0.1 + Rill 1.5.1 adapter"]
  },
  "security": {
    "authority": "advisory-only",
    "hostMutation": false,
    "pmOwns": ["authorize", "govern", "apply", "verify", "rollback"]
  },
  "historicalCompatibility": {
    "upstreamV151AdapterFixture": "contracts/upstream/rill-pm-adapter-v1.5.1-contract.json",
    "upstreamV151ReleaseVerification": "historical-only",
    "upstreamPmAdapterRequired": false
  }
}
